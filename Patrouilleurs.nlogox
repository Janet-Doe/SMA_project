  <experiments>
    <experiment name="experiment 1" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>step</go>
      <metrics>
        <metric>(nbPatrouilleurs / (count patches)) * maxMaxIdle</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="maxSteps">
          <value value="3000"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="nbPatrouilleurs">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="cognitif">
